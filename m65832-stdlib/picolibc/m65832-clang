#!/bin/bash
# Wrapper for clang that adds M65832 target flags
# Put build-fast/bin first in PATH so clang finds ld.lld (not macOS ld)
export PATH="/Users/benjamincooley/projects/llvm-m65832/build-fast/bin:$PATH"
exec /Users/benjamincooley/projects/llvm-m65832/build-fast/bin/clang \
    -target m65832-elf \
    -ffreestanding \
    "$@"
